# KisanConnect Backend Environment Configuration
# Copy this file to .env and configure your values

# Database (SQLite — relative path from backend/)
DATABASE_URL="file:../database/kisanconnect.db"

# JWT secret (change this in production!)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# data.gov.in API Key
# Get your free API key at: https://data.gov.in/user/register
# Resource: https://data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi
# Without this key, the app uses cached/demo data only.
DATA_GOV_API_KEY=

# How often to sync mandi data (hours). Default: 6
SYNC_INTERVAL_HOURS=6

# Server port
PORT=3000

# Environment
NODE_ENV=development
